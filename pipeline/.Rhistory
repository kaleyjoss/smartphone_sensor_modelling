library(mnet)
name = 'v1_day'
path <- file.path(brighten_dir, paste0(name, "_trainval_pca.csv"))
df <- read.csv(path)
pc_cols <- grep("^pc_", colnames(df), value = TRUE)
cat(pc_cols)
df$gender <- df$gender_0.0 + 1
v1_day_gender <- mlVAR_GC(data = df,  vars = pc_cols, idvar = "num_id", groups = "gender", test = "permutation", paired = FALSE, contemporaneous = "orthogonal", temporal = "orthogonal", nP = 1000, nCores = 12, pbar = TRUE)
